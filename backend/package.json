{
  "name": "airwave-airtime",
  "version": "1.0.0",
  "description": "\"An Airtime distribution automation tool API designed using Node js,Exprees\"",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "pm2 reload ecosystem.config.js --env production --update-env && pm2 logs",
    "restart": "pm2 restart topups-worker",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest =-watchAll",
    "dev": "pnpm build && pm2 start ecosystem.dev.config.js && pm2 logs",
    "pm2-start": " pm2 start ecosystem.config.js && pm2 logs",
    "make:migration": "tsx src/make-migrations.ts",
    "make:seeder": "tsx src/make-seeder.ts",
    "migrate": "tsx src/migrate.ts up",
    "migrate:undo": "tsx src/migrate.ts down",
    "docker build": "docker buildx build -f ./backend.Dockerfile",
    "seed": "sequelize-cli db:seed:all",
    "logs": "pm2 logs"
  },
  "author": "Evan ngugi wambui",
  "license": "ISC",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.3",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.1",
    "@types/validator": "^13.15.3",
    "dotenv": "^17.2.2",
    "jest": "^30.2.0",
    "multer": "^2.0.2",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@bull-board/api": "^6.13.1",
    "@bull-board/express": "^6.13.1",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.61.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "pm2": "^6.0.13",
    "redis": "^5.11.0",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.2",
    "winston": "^3.17.0",
    "zod": "^4.1.9"
  }
}
